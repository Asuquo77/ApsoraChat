# Apsora production environment
# Copy this file to .env on the server and fill in real credentials.
# NEVER commit .env.

SECRET_KEY_BASE=replace_with_secure_random_hex

FRONTEND_URL=https://YOUR-DOMAIN
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_secure_random_password
REDIS_SENTINELS=
REDIS_SENTINEL_MASTER_NAME=

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_random_password
POSTGRES_DATABASE=

RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

MAILER_SENDER_EMAIL=Apsora <noreply@YOUR-DOMAIN>
SMTP_DOMAIN=YOUR-DOMAIN
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

MAILER_INBOUND_EMAIL_DOMAIN=
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=

# Cloudflare R2 / S3-compatible object storage
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_FORCE_PATH_STYLE=false

VIPS_BLOCK_UNTRUSTED=1

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_SIZE=500

ASSET_CDN_HOST=

# Optional integrations
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

OPENSEARCH_URL=
OPENSEARCH_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
